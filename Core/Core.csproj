<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<ExcelDnaCreate32BitAddIn>true</ExcelDnaCreate32BitAddIn>
		<ExcelDnaCreate64BitAddIn>true</ExcelDnaCreate64BitAddIn>
	</PropertyGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Integration\Database\Schema\schedule_schema.sql" LogicalName="schedule_schema.sql" />
	  <EmbeddedResource Include="Integration\Database\Schema\bug_report_schema.sql" LogicalName="bug_report_schema.sql" />
	  <EmbeddedResource Include="Integration\Database\Schema\collective_dictionary_schema.sql" LogicalName="collective_dictionary_schema.sql" />
	</ItemGroup>

	<!-- Localization: embedded dictionaries (Loc fallback) + loose copies (admin-editable overrides).
	     WithCulture="false" is REQUIRED: otherwise MSBuild infers cultures from "ui.en/ms/zh/id.json" and moves
	     those files into satellite assemblies (en\Core.resources.dll ...) instead of embedding them in Core.dll.
	     Covers both ui.<code>.json (Ribbon/dialog text) and tooltips.<code>.json (Cell Guide panel). -->
	<ItemGroup>
	  <EmbeddedResource Include="Localization\*.json" LogicalName="Localization.%(Filename)%(Extension)" WithCulture="false" />
	  <None Remove="Localization\*.json" />
	  <None Include="Localization\*.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
		<PackageReference Include="Npgsql" Version="8.0.3" />
		<PackageReference Include="Dapper" Version="2.1.35" />
		<PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ZkBridge\ZkBridge.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
		</ProjectReference>
	</ItemGroup>

</Project>