<Project>
	<!-- ============================================================= -->
	<!-- 1. AUTO-CLEAN BEFORE BUILD                                     -->
	<!-- Wipes stale compiled binaries from local bin/ output folders  -->
	<!-- ============================================================= -->
	<Target Name="AutoCleanBeforeBuild" BeforeTargets="BeforeBuild">
		<Message Importance="high" Text="[Auto-Clean] Cleaning local target directory for $(MSBuildProjectName)..." />
		<ItemGroup>
			<StaleOutputFiles Include="$(TargetDir)**\*.*" />
		</ItemGroup>
		<Delete Files="@(StaleOutputFiles)" TreatErrorsAsWarnings="true" />
	</Target>

	<!-- ============================================================= -->
	<!-- 2. CLEAN STALE DEPLOYMENT ARTIFACTS BEFORE SYNC               -->
	<!-- Removes old version of this specific module from AddIns folder-->
	<!-- ============================================================= -->
	<Target Name="CleanDeployedAddInsBeforeSync"
			BeforeTargets="AutoSyncExcelDnaToDocuments"
			Condition="'@(PackageReference->WithMetadataValue(&quot;Identity&quot;, &quot;ExcelDna.AddIn&quot;))' != ''">

		<PropertyGroup>
			<TargetAddInsDir>$(UserProfile)\Documents\SKSB_App\AddIns</TargetAddInsDir>
		</PropertyGroup>

		<ItemGroup>
			<StaleAddInsFiles Include="$(TargetAddInsDir)\*$(MSBuildProjectName)*.*" />
			<StaleAddInsFiles Include="$(TargetAddInsDir)\*$(TargetName)*.*" />
		</ItemGroup>

		<Delete Files="@(StaleAddInsFiles)" TreatErrorsAsWarnings="true" />
		<Message Importance="high" Text="[Auto-Clean] Removed stale deployment files for $(MSBuildProjectName) in $(TargetAddInsDir)" />
	</Target>

	<!-- ============================================================= -->
	<!-- 3. EXCEL-DNA AUTO-SYNC TO DOCUMENTS                           -->
	<!-- Deploys newly compiled DLLs, XLLs, and packed binaries        -->
	<!-- ============================================================= -->
	<Target Name="AutoSyncExcelDnaToDocuments"
			AfterTargets="ExcelDnaPack;Build"
			Condition="'@(PackageReference->WithMetadataValue(&quot;Identity&quot;, &quot;ExcelDna.AddIn&quot;))' != ''">

		<PropertyGroup>
			<TargetAddInsDir>$(UserProfile)\Documents\SKSB_App\AddIns</TargetAddInsDir>
		</PropertyGroup>

		<MakeDir Directories="$(TargetAddInsDir)" Condition="!Exists('$(TargetAddInsDir)')" />

		<ItemGroup>
			<!-- 1. All compiled DLLs and JSON configurations -->
			<AddInArtifacts Include="$(TargetDir)*.dll" />
			<AddInArtifacts Include="$(TargetDir)*.runtimeconfig.json" />
			<AddInArtifacts Include="$(TargetDir)*.deps.json" />

			<!-- 2. The standard XLLs and DNA manifests -->
			<AddInArtifacts Include="$(TargetDir)*-AddIn*.xll" />
			<AddInArtifacts Include="$(TargetDir)*-AddIn*.dna" />

			<!-- 3. Packed standalone XLLs from publish\ -->
			<PackedArtifacts Include="$(TargetDir)publish\*-packed.xll" />
		</ItemGroup>

		<Copy SourceFiles="@(AddInArtifacts)"
			  DestinationFolder="$(TargetAddInsDir)"
			  SkipUnchangedFiles="false" />

		<Copy SourceFiles="@(PackedArtifacts)"
			  DestinationFolder="$(TargetAddInsDir)"
			  SkipUnchangedFiles="false" />

		<Message Importance="high"
				 Text="[Excel-DNA Auto-Sync] Deployed @(AddInArtifacts->Count()) artifacts to $(TargetAddInsDir)" />
	</Target>
</Project>